# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
# สร้างฐานข้อมูลก่อน: CREATE DATABASE msp_dashboard CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/msp_dashboard"

# สุ่มค่าด้วย: npx auth secret
AUTH_SECRET="change-me"

# รหัสผ่านเริ่มต้นของบัญชี admin (ใช้ตอน npm run db:seed)
ADMIN_PASSWORD="change-me"
