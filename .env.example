# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า
# สร้างฐานข้อมูลก่อน: CREATE DATABASE msp_dashboard CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/msp_dashboard"

# สุ่มค่าด้วย: npx auth secret
AUTH_SECRET="change-me"

# รหัสผ่านเริ่มต้นของบัญชี admin (ใช้ตอน npm run db:seed)
ADMIN_PASSWORD="change-me"

# Google Drive สำหรับเก็บไฟล์ Master เก่า (Gmail ส่วนตัว) — ดูขั้นตอนใน README
# ใส่ 2 ค่านี้เอง แล้วรัน npm run drive:auth ระบบจะเติม 2 ค่าล่างให้อัตโนมัติ
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""

# URL ของแอปหลังบ้าน (react-admin ใน admin-app/) — ใช้แสดงเมนู Admin และอนุญาตให้ส่งกลับไปหลังล็อกอิน
# ไม่ใส่ = ซ่อนเมนู Admin
ADMIN_APP_URL="http://localhost:5173"

# ที่เก็บไฟล์ Master ในเครื่อง (ไม่ใส่ = <โปรเจกต์>/storage/masters)
# MASTER_STORAGE_DIR=""
